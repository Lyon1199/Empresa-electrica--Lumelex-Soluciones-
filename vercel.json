{
  "installCommand": "npm ci --prefix Frontend",
  "buildCommand": "npm run build --prefix Frontend",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lumelex-backend.vercel.app/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://lumelex-backend.vercel.app/sanctum/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
